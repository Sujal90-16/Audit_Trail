model User {
  id        Int          @id @default(autoincrement())
  name      String
  email     String       @unique
  role      String
  createdAt DateTime     @default(now())
  auditLogs AuditLog[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  resource   String
  description String
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}
